/*
 * Firestore security rules for CogniCare.
 *
 * Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
 * Then open the Rules Playground and confirm:
 *   - unauthenticated get on sessions/abc  -> DENIED
 *   - authenticated but unlinked get on sessions/abc -> DENIED
 *   - authenticated linked caregiver get on sessions/abc -> ALLOWED
 *
 * Records are append-only on purpose: a device may create session and reminder
 * records and read them back for the caregiver view, but nothing can rewrite or
 * erase history, so a synced log cannot be silently altered.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /caregiverLinks/{linkId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.pairingCode is string
                    && linkId == request.auth.uid + '_' + request.resource.data.pairingCode;
      allow read: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /sessions/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.pairingCode is string;
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/caregiverLinks/$(request.auth.uid + '_' + resource.data.pairingCode));
      allow update, delete: if false;
    }

    match /reminderEvents/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.pairingCode is string;
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/caregiverLinks/$(request.auth.uid + '_' + resource.data.pairingCode));
      allow update, delete: if false;
    }
  }
}
