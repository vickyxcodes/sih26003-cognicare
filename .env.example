# Firebase web config (Spark / free plan is enough).
# Copy this file to `.env` and paste your own values from:
#   Firebase console > Project settings > General > Your apps > SDK setup and configuration > Config
#
# These values are NOT secrets: the Firebase web config is shipped inside every
# client bundle by design. Access is controlled by Firestore security rules
# (see firestore.rules), not by hiding these keys.
#
# If you leave them blank the app still runs end to end in LOCAL-ONLY MODE:
# games, IndexedDB logging, reminders, voice and the caregiver dashboard all work,
# and records simply stay queued until real credentials are present.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
